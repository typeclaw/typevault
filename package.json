{
  "name": "typevault",
  "version": "0.1.0",
  "description": "CLI-first secrets vault for agents",
  "homepage": "https://github.com/typeclaw/typevault#readme",
  "bugs": {
    "url": "https://github.com/typeclaw/typevault/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/typeclaw/typevault.git"
  },
  "bin": {
    "typevault": "src/cli/index.ts"
  },
  "files": [
    "src",
    "!**/*.test.ts"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./admin": "./src/admin.ts",
    "./redact": "./src/redact/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "test": "bun test"
  },
  "dependencies": {
    "@1password/sdk": "^0.5.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "age-encryption": "^0.3.1",
    "citty": "^0.2.2",
    "fflate": "^0.8.3",
    "hash-wasm": "^4.12.0",
    "kdbxweb": "^2.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.15"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
